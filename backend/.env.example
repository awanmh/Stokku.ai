# App
APP_ENV=development
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5440
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=stokku
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRATION_HOURS=24

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Stokku.ai
