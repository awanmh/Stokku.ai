# Docker Compose Environment Variables
# Copy this to .env and adjust values

# App
APP_ENV=development

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stokku
DB_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend
SERVER_PORT=8080
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRATION_HOURS=24

# Web
WEB_PORT=3000
