# Web Frontend Environment Variables
# Leave NEXT_PUBLIC_API_URL empty to use Next.js proxy (recommended for dev)
# Set explicitly only for Docker production builds or external API
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Internal backend URL for the Next.js rewrite proxy
BACKEND_INTERNAL_URL=http://localhost:8081

# Gemini API key for the chatbot route
GEMINI_API_KEY=

# Default Gemini model used by the chatbot route
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
