# ==========================================
# STOKKU.AI SHARED ENVIRONMENT VARIABLES
# ==========================================
# File ini berisi semua environment variables yang dibutuhkan oleh tim.
# Copy isinya ke masing-masing direktori yang sesuai.
#
# CARA PENGGUNAAN:
# 1. Untuk Backend: Copy bagian BACKEND ke `backend/.env`
# 2. Untuk Frontend: Copy bagian FRONTEND ke `web/.env`

# ------------------------------------------
# BACKEND (.env untuk direktori backend)
# ------------------------------------------
APP_ENV=development
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5440
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=stokku
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRATION_HOURS=24

# SMTP (Gmail) - REQUIRED FOR OTP LOGIN
# Instruksi Setup SMTP:
# 1. Gunakan akun Gmail.
# 2. Aktifkan 2-Step Verification di Google Account -> Security.
# 3. Buat App Password di: https://myaccount.google.com/apppasswords
# 4. Gunakan 16-karakter App Password tersebut sebagai SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Stokku.ai

# ------------------------------------------
# FRONTEND (.env untuk direktori web)
# ------------------------------------------
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8080

# Gemini AI - REQUIRED FOR CHATBOT
# Instruksi Setup Gemini:
# 1. Dapatkan API key dari Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Ganti nilai GEMINI_API_KEY di bawah dengan key Anda.
# 3. PERINGATAN: Jangan pernah commit file .env yang berisi API key asli!
GEMINI_API_KEY=your-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
